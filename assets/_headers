# Static-asset security headers (applied by Cloudflare on asset responses).
# The console is a single-file SPA with inline scripts, so 'unsafe-inline' is
# required for script-src; everything else is locked to same-origin + MS fonts.
# Keep this policy in sync with the CSP constant in src/index.ts.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
